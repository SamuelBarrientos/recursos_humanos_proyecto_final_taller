<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="10.0" prefWidth="400.0" prefHeight="420.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.magcorporation.kinal.controller.RegistroController">
    <padding>
        <Insets top="20.0" right="25.0" bottom="20.0" left="25.0" />
    </padding>

    <Label text="Registro de Usuario">
        <font>
            <Font size="18.0" />
        </font>
    </Label>

    <VBox spacing="3.0" fillWidth="true">
        <Label text="Nombre:" />
        <TextField fx:id="txtNombre" promptText="Ingresa tu nombre" />
    </VBox>

    <VBox spacing="3.0" fillWidth="true">
        <Label text="Apellido:" />
        <TextField fx:id="txtApellido" promptText="Ingresa tu apellido" />
    </VBox>

    <VBox spacing="3.0" fillWidth="true">
        <Label text="Correo Electrónico:" />
        <TextField fx:id="txtCorreo" promptText="ejemplo@kinal.edu.gt" />
    </VBox>

    <VBox spacing="3.0" fillWidth="true">
        <Label text="Contraseña:" />
        <PasswordField fx:id="txtPassword" promptText="••••••••" />
    </VBox>

    <VBox spacing="3.0" fillWidth="true">
        <Label text="Rol:" />
        <ComboBox fx:id="cmbRol" prefWidth="350.0" />
    </VBox>

    <Button text="Registrar" onAction="#handleRegistrar" prefWidth="150.0" />
    <Button text="Volver al Login" onAction="#handleIrLogin" prefWidth="150.0" />
</VBox>