<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="640.0" prefWidth="900.0" spacing="12.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.magcorporation.kinal.controller.DashboardController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>

    <Label fx:id="lblBienvenida">
        <font>
            <Font size="14.0" />
        </font>
    </Label>

    <Label text="Panel Principal (Dashboard)" textFill="#a42020">
        <font>
            <Font size="20.0" />
        </font>
    </Label>

    <Label text="Inventario de Aspirantes">
        <font>
            <Font size="14.0" />
        </font>
    </Label>

    <Label fx:id="lblRol">
        <font>
            <Font size="14.0" />
        </font>
    </Label>

    <TableView fx:id="tblAspirantes" prefHeight="380.0" prefWidth="850.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="168.0" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="142.0" text="Nombre" />
            <TableColumn fx:id="colApellido" prefWidth="100.0" text="Apellido" />
            <TableColumn fx:id="colCorreo" prefWidth="106.0" text="Correo" />
            <TableColumn fx:id="colTelefono" prefWidth="134.0" text="Teléfono" />
            <TableColumn fx:id="colDireccion" prefWidth="110.0" text="Dirección" />
            <TableColumn fx:id="colEdad" prefWidth="110.0" text="Edad" />
        </columns>
    </TableView>

    <HBox alignment="CENTER" spacing="10.0">
        <TextField fx:id="txtNombre" prefWidth="130.0" promptText="Nombre" />
        <TextField fx:id="txtApellido" prefWidth="130.0" promptText="Apellido" />
        <TextField fx:id="txtCorreo" prefWidth="190.0" promptText="Correo" />
        <TextField fx:id="txtTelefono" prefWidth="120.0" promptText="Teléfono" />
        <TextField fx:id="txtEdad" prefWidth="70.0" promptText="Edad" />
    </HBox>

    <HBox alignment="CENTER" spacing="10.0">
        <TextField fx:id="txtDireccion" prefWidth="500.0" promptText="Dirección" />
    </HBox>

    <HBox alignment="CENTER" spacing="10.0">
        <Button onAction="#handleAgregarAspirante" prefWidth="110.0" text="Agregar" />
        <Button onAction="#handleActualizarAspirante" prefWidth="110.0" text="Actualizar" />
        <Button onAction="#handleEliminarAspirante" prefWidth="110.0" text="Eliminar" />
        <Button onAction="#handleLimpiar" prefWidth="110.0" text="Limpiar" />
        <Button onAction="#handleCerrarSesion" prefWidth="140.0" text="Cerrar Sesión" />
    </HBox>
</VBox>
